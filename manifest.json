{
  "manifest_version": 3,
  "name": "Site Memory",
  "version": "2.0.0",
  "description": "Highlight text on any website and it automatically reappears when you revisit. Organized by page, stored locally.",
  
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/utils/helpers.js",
        "src/storage/storage.js",
        "src/content/highlighter.js",
        "src/ui/sidebar.js",
        "src/content/main.js"
      ],
      "css": [
        "src/ui/styles/main.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle the sidebar"
    }
  }
}
