{
  "manifest_version": 3,
  "name": "Site Memory",
  "version": "2.0.0",
  "description": "Highlight text on any website and it automatically reappears when you revisit. Organized by page, stored locally.",
  
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "scripting"
  ],
  
  "host_permissions": [
    "<all_urls>",
    "file://*/*"
  ],
  
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file://*/*"],
      "js": [
        "src/utils/helpers.js",
        "src/storage/storage.js",
        "src/content/highlighter.js",
        "src/ui/sidebar.js",
        "src/content/main.js"
      ],
      "css": [
        "src/ui/styles/main.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "web_accessible_resources": [{
    "resources": ["src/pdf/*", "src/welcome/welcome.html"],
    "matches": ["<all_urls>"]
  }]
}
